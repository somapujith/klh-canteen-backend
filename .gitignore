node_modules/
dist/
.env
# Local test-suite config; copy .env.test.example. Never commit a real
# connection string here — the guard cannot protect a leaked credential.
.env.test
# Deploy tooling credentials — never loaded by the app itself, so they stay
# out of the runtime .env. Same reasoning as .env: never commit a real value
# here.
.env.deploy
*.log
.superpowers/
.wrangler/
.DS_Store

.github/workflows/

# Load-test credential files. These hold plaintext passwords for real
# accounts, so they must never reach the repo. Generated by
# scripts/perf/makeLoadTestUsers.ts, consumed by scripts/perf/prodLoadTest.ts.
loadtest-*.json
*.creds.json
scripts/perf/*.json
**/creds*.json
**/*-creds.json

# Local dumps of production order data (student names, order history).
order-backup-*.json
