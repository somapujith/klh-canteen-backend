generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  DELIVERED
}

enum Kitchen {
  SNACKS
  MEALS
}

model User {
  id           String   @id @default(uuid())
  role         Role
  rollNumber   String?  @unique
  email        String   @unique
  passwordHash String
  name         String
  kitchen      Kitchen?
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  sortOrder Int        @default(0)
  kitchen   Kitchen    @default(SNACKS)
  items     MenuItem[]
}

model MenuItem {
  id          String      @id @default(uuid())
  name        String
  imageUrl    String
  price       Decimal     @db.Decimal(10, 2)
  stockQty    Int
  isAvailable Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([categoryId])
}

model Order {
  id          String      @id @default(uuid())
  studentId   String
  student     User        @relation(fields: [studentId], references: [id])
  status      OrderStatus @default(PENDING)
  kitchen     Kitchen     @default(SNACKS)
  token       String      @unique
  orderNumber Int         @default(0)
  totalAmount Decimal     @db.Decimal(10, 2)
  createdAt       DateTime    @default(now())
  deliveredAt     DateTime?
  lockedByAdminId String?
  lockedAt        DateTime?
  items           OrderItem[]

  @@index([studentId])
  @@index([createdAt])
  @@index([kitchen, createdAt])
}

model OrderSequence {
  weekId     String @id
  lastNumber Int    @default(999)
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
  quantity     Int
  priceAtOrder Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([menuItemId])
}
