generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  PREPARING
  COOKED
  DELIVERED
  /// Terminal, and the only non-DELIVERED terminal state. Reaching it
  /// releases the order's stock reservation (see releaseOrderReservation()).
  CANCELLED
}

enum Kitchen {
  SNACKS
  MEALS
}

model User {
  id           String     @id @default(uuid())
  role         Role
  rollNumber   String?    @unique
  email        String     @unique
  passwordHash String
  name         String
  kitchen      Kitchen?
  createdAt    DateTime   @default(now())

  /// Students are bulk-created on a shared default password; they must set
  /// their own before they can order. Seeded admins are exempt.
  mustChangePassword Boolean @default(false)
  /// Soft-deactivation for students who have left. Preserves their order
  /// history, which a hard delete would take with it.
  isActive           Boolean @default(true)
  /// Tokens issued before this instant are rejected — the revocation cutoff
  /// used by logout-everywhere and by deactivation.
  tokensValidFrom    DateTime?

  orders       Order[]
  auditLogs    AuditLog[]

  @@index([role, isActive])
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  sortOrder Int        @default(0)
  kitchen   Kitchen    @default(SNACKS)
  items     MenuItem[]
}

model MenuItem {
  id          String      @id @default(uuid())
  name        String
  imageUrl    String
  price       Decimal     @db.Decimal(10, 2)
  stockQty    Int
  /// Portions already promised to placed-but-not-yet-settled orders.
  ///
  /// `stockQty` is what physically exists; `stockQty - reservedQty` is what
  /// is still sellable. Only ever moved by a single conditional UPDATE
  /// guarded on `stockQty - reservedQty >= n` — never read-then-write — so
  /// N concurrent baskets for the last portion produce exactly one winner.
  ///
  /// This column is a denormalised cache of the Order ledger: the truth is
  /// SUM(OrderItem.quantity) over orders with `reservedAt` set and
  /// `stockSettledAt` still null. reconcileReservations() rebuilds it from
  /// that ledger, so a worker killed mid-request cannot strand stock.
  reservedQty Int         @default(0)
  isAvailable Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([categoryId])
}

/// An order is owned by EXACTLY ONE of two parties, never both and never
/// neither:
///
///   - a student  -> `studentId` set, `guestSessionId` null
///   - a walk-up guest -> `guestSessionId` set, `studentId` null
///
/// Postgres cannot express "exactly one of these two columns is non-null"
/// through Prisma's schema language, so the invariant is enforced in the
/// service layer (see assertSingleOwner() in src/services/orderService.ts)
/// and every guest read is scoped by `guestSessionId` in its WHERE clause,
/// exactly as student reads are scoped by `studentId`.
model Order {
  id          String      @id @default(uuid())
  /// Nullable since guest orders have no account behind them.
  studentId   String?
  /// onDelete stays Restrict (Prisma would default an optional relation to
  /// SetNull): silently nulling studentId on a user delete would produce an
  /// order owned by neither a student nor a guest, breaking the invariant
  /// above and making the row unreadable by anyone but an admin.
  student     User?       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  /// Opaque, HMAC-signed session identity for a walk-up guest. This is the
  /// ONLY key a guest can read their own orders by — it is never accepted
  /// raw from the client, always recovered from a verified session token.
  guestSessionId String?
  /// Display name a guest optionally gave at the counter, so the kitchen
  /// board has something to call out. Not identity, not authentication.
  guestName      String?
  guestPhone     String?
  status      OrderStatus @default(PENDING)
  kitchen     Kitchen     @default(SNACKS)
  token       String      @unique
  orderNumber Int         @default(0)
  totalAmount Decimal     @db.Decimal(10, 2)
  createdAt       DateTime    @default(now())
  /// Start of the pre-booked collection window. NULL means "as soon as
  /// possible" — the behaviour every existing client already gets.
  collectionAt    DateTime?
  deliveredAt     DateTime?
  /// When this order claimed its stock. NULL on orders placed before stock
  /// reservation existed — those still decrement stock at DELIVERED, which
  /// is exactly what they did when they were written.
  reservedAt           DateTime?
  /// When the claim stops being honoured and the sweeper may hand the
  /// portions back. Never collected, never cooked: the stock returns.
  reservationExpiresAt DateTime?
  /// When the claim was consumed (DELIVERED) or handed back (CANCELLED /
  /// expired). Non-null means "this order no longer holds stock", and the
  /// conditional UPDATE that sets it is what makes release idempotent — a
  /// double cancel, or a cancel racing the sweeper, moves reservedQty once.
  stockSettledAt       DateTime?
  seenByAdmin     Boolean     @default(false)
  seenAt          DateTime?
  lockedByAdminId String?
  lockedAt        DateTime?
  items           OrderItem[]

  @@index([studentId])
  @@index([guestSessionId])
  @@index([createdAt])
  @@index([kitchen, createdAt])
  /// The kitchen board filters on kitchen + status and orders by createdAt;
  /// (kitchen, createdAt) alone forced a filter-then-discard over every
  /// delivered order in the window.
  @@index([kitchen, status, createdAt])
  @@index([collectionAt])
  /// Serves the expiry sweeper, which asks only "which outstanding
  /// reservations are past their deadline".
  @@index([stockSettledAt, reservationExpiresAt])
}

/// Capacity ledger for pre-booked collection windows.
///
/// One row per (slot start, kitchen): each kitchen cooks independently, so a
/// cart that splits into a SNACKS order and a MEALS order reserves a seat in
/// each kitchen's window rather than double-charging one shared ceiling.
/// `bookedCount` is only ever moved by a conditional UPDATE guarded on
/// `bookedCount < capacity`, which makes the ceiling atomic under concurrent
/// booking instead of a read-then-write race.
model CollectionWindow {
  id          String   @id @default(uuid())
  startAt     DateTime
  kitchen     Kitchen
  capacity    Int      @default(20)
  bookedCount Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([startAt, kitchen])
  @@index([startAt])
}

model OrderSequence {
  weekId     String @id
  lastNumber Int    @default(999)
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
  quantity     Int
  priceAtOrder Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([menuItemId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}
