# Environment for the AUTOMATED TEST SUITE ONLY.
#
# Copy to `.env.test`. The suite reads this file and NEVER `.env`, which points
# at the shared live Neon database (154 real users, 191 orders). See TESTING.md.
#
# Everything in this file is disposable: the suite deletes every row in User,
# Order, OrderItem, MenuItem and Category between tests.

# --- A dedicated Neon BRANCH ---------------------------------------------------
# Create a branch that is NOT `main`/production (Neon console, or
# `neonctl branches create --project-id <id> --name test`), give it a database
# whose name contains "test" (`neonctl databases create ... --name foo_test`),
# then:
#   1. set DATABASE_URL to that database's connection string,
#   2. uncomment the opt-in below.
# The guard still refuses any URL that matches the one in `.env`. A real Neon
# branch terminates WebSockets itself, so no local proxy/Docker is needed.
DATABASE_URL="postgresql://user:pass@ep-example-branch.region.aws.neon.tech/klh_canteen_test?sslmode=require"
ALLOW_REMOTE_TEST_DATABASE=1

# Secrets below are fake on purpose. Never copy real ones in here.
JWT_SECRET="test-jwt-secret-do-not-use-anywhere-real"
QR_TOKEN_SECRET="test-qr-secret-do-not-use-anywhere-real"
CORS_ORIGIN="*"
