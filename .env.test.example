# Environment for the AUTOMATED TEST SUITE ONLY.
#
# Copy to `.env.test`. The suite reads this file and NEVER `.env`, which points
# at the shared live Neon database (154 real users, 191 orders). See TESTING.md.
#
# Everything in this file is disposable: the suite deletes every row in User,
# Order, OrderItem, MenuItem and Category between tests.

# --- Option A (recommended): local Postgres via Docker -----------------------
#   npm run test:db:up      starts postgres + the Neon WebSocket proxy
#   npm run test:db:down    tears them down
# The database name MUST contain "test" or the guard refuses to run.
DATABASE_URL="postgresql://klh_test:klh_test@localhost:55433/klh_canteen_test"

# host:port of the wsproxy container. @neondatabase/serverless (the driver the
# app uses) talks Postgres over WebSockets, so a plain local Postgres needs
# this terminator in front of it. Ignored for remote Neon targets.
NEON_WS_PROXY="localhost:55480"

# --- Option B: a dedicated Neon BRANCH ---------------------------------------
# Create a branch that is NOT `main`/production, then:
#   1. set DATABASE_URL to that branch's connection string,
#   2. give the branch a database whose name contains "test",
#   3. uncomment the opt-in below.
# The guard still refuses any URL that matches the one in `.env`.
# ALLOW_REMOTE_TEST_DATABASE=1

# Secrets below are fake on purpose. Never copy real ones in here.
JWT_SECRET="test-jwt-secret-do-not-use-anywhere-real"
QR_TOKEN_SECRET="test-qr-secret-do-not-use-anywhere-real"
CORS_ORIGIN="*"
