DATABASE_URL="postgresql://klh:klh@localhost:5433/klh_canteen?schema=public"
JWT_SECRET="change-me-dev-secret"
QR_TOKEN_SECRET="change-me-dev-qr-secret"
CORS_ORIGIN="http://localhost:5175"
PORT=4000
DB_POOL_MAX=20
# Student order notifications (never commit real values)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# UPI payments (VyaparGateway). Never commit real values.
# ---------------------------------------------------------------------------
# "true" turns checkout on. Anything else leaves ordering as it was before
# payments existed. Both this AND the credentials below are required — a
# flag-only deploy reads as "off" rather than half-enabling the feature.
PAYMENTS_ENABLED="false"
# Live API key from the dashboard (vg_live_...).
VYAPAR_API_KEY=""
# Webhook signing secret (whsec_...). The HMAC key every inbound payment
# notification is verified against — treat it exactly like a password.
VYAPAR_WEBHOOK_SECRET=""
# Our own webhook endpoint. Must be publicly reachable: the gateway's servers
# call it, not the browser. For local development use a tunnel, e.g.
#   cloudflared tunnel --url http://localhost:4000
# and paste the https URL it prints, with /payments/webhook appended.
VYAPAR_CALLBACK_URL="http://localhost:4000/payments/webhook"
# Optional. Where the gateway sends the browser after payment.
VYAPAR_REDIRECT_URL=""
