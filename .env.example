DATABASE_URL="postgresql://klh:klh@localhost:5433/klh_canteen?schema=public"
JWT_SECRET="change-me-dev-secret"
QR_TOKEN_SECRET="change-me-dev-qr-secret"
CORS_ORIGIN="http://localhost:5175"
PORT=4000
DB_POOL_MAX=20
# Student order notifications (never commit real values)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# UPI payments (SafeUPI). Never commit real values.
# ---------------------------------------------------------------------------
# "true" turns checkout on. Anything else leaves ordering as it was before
# payments existed. Both this AND the credentials below are required — a
# flag-only deploy reads as "off" rather than half-enabling the feature.
PAYMENTS_ENABLED="false"
# SafeUPI API key, sent as `secret` in every request body.
SAFEUPI_API_SECRET=""
# The value SafeUPI echoes back inside a webhook body. NOT a signing key —
# SafeUPI does not sign webhooks — so treat it as a bearer credential and
# never log a webhook body. Settlements are additionally confirmed against
# SafeUPI's Status API before any food is released.
SAFEUPI_WEBHOOK_SECRET=""
# Where SafeUPI returns the browser after the hosted payment page. The payment
# id is appended as a query parameter automatically.
SAFEUPI_REDIRECT_URL="http://localhost:5175/payment/complete"
# Optional: route to a specific connected merchant. Omitted, SafeUPI picks the
# business default and falls back to other eligible merchants.
SAFEUPI_MERCHANT_ID=""
