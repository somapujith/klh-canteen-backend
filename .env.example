DATABASE_URL="postgresql://klh:klh@localhost:5433/klh_canteen?schema=public"
JWT_SECRET="change-me-dev-secret"
QR_TOKEN_SECRET="change-me-dev-qr-secret"
CORS_ORIGIN="http://localhost:5175"
PORT=4000
DB_POOL_MAX=20
# Student order notifications (never commit real values)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# UPI payments (GuruPay). Never commit real values.
# ---------------------------------------------------------------------------
# "true" turns checkout on. Anything else leaves ordering as it was before
# payments existed. Both this AND the credentials below are required — a
# flag-only deploy reads as "off" rather than half-enabling the feature.
PAYMENTS_ENABLED="false"
# GuruPay merchant API key, sent as the `X-Guru-Key` header on every request.
GURUPAY_API_KEY=""
# GuruPay signs nothing, so there is no webhook secret to set. Every
# settlement is instead confirmed by calling GuruPay's own check-status API
# before any food is released — see paymentService.ts's trust-model note.
# Where GuruPay returns the browser after the hosted payment page. The
# payment id is appended as a query parameter automatically.
GURUPAY_REDIRECT_URL="http://localhost:5175/payment/complete"
